{
  "$defs": {
    "Connectivity": {
      "properties": {
        "metric": {
          "default": "plv",
          "enum": [
            "plv",
            "coh"
          ],
          "title": "Metric",
          "type": "string"
        },
        "band": {
          "title": "Band",
          "type": "string"
        },
        "channels": {
          "items": {
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "matrix": {
          "description": "symmetric channels x channels matrix, 1 on the diagonal",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        }
      },
      "required": [
        "band",
        "channels",
        "matrix"
      ],
      "title": "Connectivity",
      "type": "object"
    },
    "HeuristicState": {
      "properties": {
        "value": {
          "description": "EMA-smoothed index value",
          "title": "Value",
          "type": "number"
        },
        "raw_value": {
          "description": "value of this window only",
          "title": "Raw Value",
          "type": "number"
        },
        "source": {
          "const": "heuristic_index",
          "default": "heuristic_index",
          "title": "Source",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "note": {
          "default": "heuristic index \u2014 not a trained prediction",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "value",
        "raw_value",
        "formula"
      ],
      "title": "HeuristicState",
      "type": "object"
    },
    "SignalQuality": {
      "properties": {
        "overall": {
          "description": "1 - fraction of bad channels in this window",
          "maximum": 1,
          "minimum": 0,
          "title": "Overall",
          "type": "number"
        },
        "flag": {
          "description": "good: no bad channel; warn: blinks or <=2 bad; bad: more",
          "enum": [
            "good",
            "warn",
            "bad"
          ],
          "title": "Flag",
          "type": "string"
        },
        "bad_channels": {
          "description": "channels failing a check in this window",
          "items": {
            "type": "string"
          },
          "title": "Bad Channels",
          "type": "array"
        },
        "interpolated_channels": {
          "description": "persistently bad channels rebuilt by spherical-spline interpolation",
          "items": {
            "type": "string"
          },
          "title": "Interpolated Channels",
          "type": "array"
        }
      },
      "required": [
        "overall",
        "flag"
      ],
      "title": "SignalQuality",
      "type": "object"
    },
    "States": {
      "properties": {
        "workload": {
          "$ref": "#/$defs/WorkloadState"
        },
        "attention": {
          "$ref": "#/$defs/HeuristicState"
        },
        "fatigue": {
          "$ref": "#/$defs/HeuristicState"
        },
        "readiness": {
          "$ref": "#/$defs/HeuristicState"
        }
      },
      "required": [
        "workload",
        "attention",
        "fatigue",
        "readiness"
      ],
      "title": "States",
      "type": "object"
    },
    "WorkloadState": {
      "properties": {
        "label": {
          "description": "argmax class of the smoothed probabilities",
          "title": "Label",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "calibrated, EMA-smoothed class probabilities (sum to 1)",
          "title": "Probabilities",
          "type": "object"
        },
        "raw_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "calibrated probabilities of this window only (no smoothing)",
          "title": "Raw Probabilities",
          "type": "object"
        },
        "confidence": {
          "description": "max smoothed probability",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "const": "model",
          "default": "model",
          "title": "Source",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "task": {
          "description": "workload_binary (low/high) or workload_within_task (moderate/high)",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "label",
        "probabilities",
        "raw_probabilities",
        "confidence",
        "model_version",
        "task"
      ],
      "title": "WorkloadState",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "participant_id": {
      "title": "Participant Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "window_index": {
      "minimum": 0,
      "title": "Window Index",
      "type": "integer"
    },
    "timestamp_start": {
      "description": "ISO 8601 UTC start of the analysis window",
      "title": "Timestamp Start",
      "type": "string"
    },
    "timestamp_end": {
      "description": "ISO 8601 UTC end of the analysis window",
      "title": "Timestamp End",
      "type": "string"
    },
    "t_start_s": {
      "description": "seconds since the start of the session",
      "title": "T Start S",
      "type": "number"
    },
    "t_end_s": {
      "title": "T End S",
      "type": "number"
    },
    "signal_quality": {
      "$ref": "#/$defs/SignalQuality"
    },
    "states": {
      "$ref": "#/$defs/States"
    },
    "band_power": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "description": "channel -> band -> absolute power (uV^2)",
      "title": "Band Power",
      "type": "object"
    },
    "band_power_unit": {
      "default": "uV^2",
      "title": "Band Power Unit",
      "type": "string"
    },
    "connectivity": {
      "$ref": "#/$defs/Connectivity"
    },
    "latency_ms": {
      "description": "processing time of this window (quality + preprocessing + features + model)",
      "title": "Latency Ms",
      "type": "number"
    }
  },
  "required": [
    "participant_id",
    "session_id",
    "window_index",
    "timestamp_start",
    "timestamp_end",
    "t_start_s",
    "t_end_s",
    "signal_quality",
    "states",
    "band_power",
    "connectivity",
    "latency_ms"
  ],
  "title": "CognitiveStateOutput",
  "type": "object",
  "$id": "https://j26-ds-333/eeg-engine/cognitive-state-output.schema.json"
}